{
  "name": "samurai-trading-system",
  "version": "0.0.1",
  "private": true,
  "description": "Samurai v2 — autonomous, self-improving equities trading system (momentum + LLM-debate sleeves, £1,500/yr loss budget). See CLAUDE.md, CONTEXT.md and docs/adr/0001-samurai-v2.md.",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "vite dev --config client/vite.config.ts",
    "dev:api": "tsx watch --env-file=.env.local server/apps/service-api/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:migrations && npm run build:web",
    "build:migrations": "node --eval \"const fs=require('node:fs');fs.cpSync('server/shared/store/migrations','dist/server/shared/store/migrations',{recursive:true});fs.cpSync('server/providers/market-intelligence/archive/migrations','dist/server/providers/market-intelligence/archive/migrations',{recursive:true});\"",
    "build:web": "tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "npm run build && node --env-file=.env.local dist/server/apps/supervisor/index.js",
    "orchestrator": "npm run build && node --env-file=.env.local dist/server/apps/orchestrator/index.js",
    "api": "npm run build && node --env-file=.env.local dist/server/apps/service-api/index.js",
    "v2:capital": "tsx server/apps/v2/set-capital.ts",
    "v2:entry-offsets": "tsx server/apps/v2/report-entry-offsets.ts",
    "v2:backup": "node --env-file-if-exists=.env.local --import tsx server/apps/v2/backup-cli.ts backup",
    "v2:restore": "node --env-file-if-exists=.env.local --import tsx server/apps/v2/backup-cli.ts restore",
    "v2:dashboard": "node --env-file-if-exists=.env.local --import tsx server/apps/v2/api/main.ts",
    "v2:trials": "tsx server/apps/v2/trial-ledger.ts",
    "smoke": "npm run build && node dist/server/apps/orchestrator/smoke-run.js && node dist/server/apps/v2/smoke.js",
    "serve": "npm run start",
    "dashboard": "npm run api",
    "data": "npm run build && node --env-file=.env.local dist/server/tools/data-cli.js",
    "ingest-history": "npm run data -- ingest-history",
    "backfill-market-data": "npm run data -- backfill-market-data",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json && tsc -p client/tsconfig.test.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:local": "vitest run --changed origin/main",
    "test:watch": "vitest",
    "mutation:local": "tsx server/tools/mutation-local.ts",
    "crap": "vitest run --coverage --coverage.reporter=json && tsx server/tools/crap-gate.ts --threshold 15 && tsx server/tools/crap-gate.ts --threshold 7 --changed-since origin/main --strict server/apps/v2 --strict contracts",
    "crap:report": "tsx server/tools/crap-gate.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "check:citations": "tsx server/tools/check-path-citations.ts",
    "check:live-gates": "tsx server/tools/check-live-money-gates.ts",
    "report:arms": "tsx server/tools/report-arm-comparison.ts",
    "report:cgt": "tsx server/tools/report-cgt-disposals.ts",
    "report:debate-flip-rate": "tsx server/tools/report-debate-round-flip-rate.ts",
    "report:debate-conviction": "tsx server/tools/replay-debate-conviction.ts",
    "classify:debate-termination": "tsx server/tools/classify-debate-termination.ts",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check --write .",
    "lint": "npm run lint:oxlint && npm run lint:biome",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:biome:fix",
    "fallow:boundaries": "fallow dead-code --boundary-violations --fail-on-issues",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:css": "fallow health --css",
    "fallow:guard": "fallow guard",
    "precommit": "npm run lint:fix && npm run typecheck && npm run test:local && npm run fallow:boundaries && npm run fallow:dead-code && npm run fallow:dupes && npm run fallow:css && files=$(git diff --cached --name-only --diff-filter=ACM); [ -z \"$files\" ] || npm run fallow:guard -- $files",
    "place-soak-position": "tsx --env-file=.env.local server/tools/place-soak-position.ts",
    "saxo:login": "tsx --env-file=.env.local server/tools/saxo-login.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint-plugin-no-comment-slop": "0.3.0",
    "fallow": "3.26.0",
    "jsdom": "30.0.1",
    "oxlint": "1.83.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "better-sqlite3": "13.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "qs": "6.16.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
