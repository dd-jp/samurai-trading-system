{
  "name": "samurai-trading-system",
  "version": "0.0.1",
  "private": true,
  "description": "Samurai — live-money multi-agent trading system (crypto + stocks). See CLAUDE.md and docs/specs/.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && yarn build:migrations && yarn build:web",
    "build:migrations": "node --eval \"require('node:fs').cpSync('src/shared/store/migrations','dist/shared/store/migrations',{recursive:true})\"",
    "build:web": "tsc -p src/dashboard-web/tsconfig.json && vite build --config src/dashboard-web/vite.config.ts",
    "dev:web": "vite dev --config src/dashboard-web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "precommit": "yarn format && yarn lint:fix && yarn typecheck && yarn test:coverage",
    "orchestrator": "yarn build && node --env-file=.env.local dist/orchestrator/index.js",
    "smoke": "yarn build && node dist/orchestrator/smoke-run.js",
    "dashboard": "yarn build && node --env-file=.env.local dist/dashboard/index.js",
    "serve": "yarn build && node --env-file=.env.local dist/serve/index.js",
    "ingest-history": "yarn build && node --env-file=.env.local dist/scripts/ingest-tiingo-history.js",
    "backfill-market-data": "yarn build && node --env-file=.env.local dist/scripts/backfill-market-data.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "packageManager": "yarn@4.18.0"
}
