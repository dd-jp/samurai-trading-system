{
  "name": "samurai-trading-system",
  "version": "0.0.1",
  "private": true,
  "description": "Samurai — live-money multi-agent trading system (crypto + stocks). See CLAUDE.md and docs/specs/.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "vite dev --config client/vite.config.ts",
    "dev:api": "tsx watch --env-file=.env.local server/apps/service-api/index.ts",
    "build": "tsc -p tsconfig.build.json && yarn build:migrations && yarn build:web",
    "build:migrations": "node --eval \"const fs=require('node:fs');fs.cpSync('server/shared/store/migrations','dist/server/shared/store/migrations',{recursive:true});fs.cpSync('server/providers/market-intelligence/archive/migrations','dist/server/providers/market-intelligence/archive/migrations',{recursive:true});\"",
    "build:web": "tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "yarn build && node --env-file=.env.local dist/server/apps/supervisor/index.js",
    "orchestrator": "yarn build && node --env-file=.env.local dist/server/apps/orchestrator/index.js",
    "api": "yarn build && node --env-file=.env.local dist/server/apps/service-api/index.js",
    "smoke": "yarn build && node dist/server/apps/orchestrator/smoke-run.js",
    "serve": "yarn start",
    "dashboard": "yarn api",
    "data": "yarn build && node --env-file=.env.local dist/server/tools/data-cli.js",
    "ingest-history": "yarn data ingest-history",
    "backfill-market-data": "yarn data backfill-market-data",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json && tsc -p client/tsconfig.test.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:local": "vitest run --changed origin/main",
    "test:watch": "vitest",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "check:citations": "tsx server/tools/check-path-citations.ts",
    "check:live-gates": "tsx server/tools/check-live-money-gates.ts",
    "report:arms": "tsx server/tools/report-arm-comparison.ts",
    "classify:debate-termination": "tsx server/tools/classify-debate-termination.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "precommit": "yarn lint:fix && yarn typecheck && yarn test:coverage",
    "place-soak-position": "tsx --env-file=.env.local server/tools/place-soak-position.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "better-sqlite3": "^13.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "packageManager": "yarn@4.18.0"
}
