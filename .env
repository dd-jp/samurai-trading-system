POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
SAXO_SIM_ACCESS_TOKEN=
SAMURAI_MODE=paper
# Nous is the single LLM provider (ADR-0009). Base URL is required — there is
# deliberately no default in source, so a run cannot silently point at a stale
# endpoint. The portal's address is also the NOUS_BASE_URL repository variable
# used by the CI reviewer.
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# Shared key, used by every role that has no key of its own.
NOUS_API_KEY=
# Per-role overrides. A key per model is the supported shape: set the pair for
# a role and it uses them; leave them unset and it falls back to NOUS_API_KEY
# and the role's default model (shared/llm/nous-config.ts).
#   debate    -> anthropic/claude-haiku-4.5
#   sentiment -> x-ai/grok-4.5   (pinned on purpose — ADR-0009. The floating
#                alias `~x-ai/grok-latest` also works; the leading ~ is required
#                on it, the bare `x-ai/grok-latest` 404s.)
# A model set here MUST have a rate in shared/llm/pricing.ts, or startup
# refuses: an unpriced call records a null cost and the spend cap sums nulls
# as zero, which would silently remove ADR-0008's $50/14d ceiling.
NOUS_DEBATE_API_KEY=
NOUS_DEBATE_MODEL=
NOUS_SENTIMENT_API_KEY=
NOUS_SENTIMENT_MODEL=
# Only the literal `off` disables the market-intelligence sentiment agent;
# blank, unset or anything else runs it. The analysts report NO DATA rather than
# a fabricated neutral read when it is off — and, per ADR-0009's measurement,
# also when it is on, because without live retrieval the honest answer is an
# empty item list. Left enabled at ~$0.50/soak to keep the caller exercised.
SAMURAI_SENTIMENT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_HEARTBEAT_CHAT_ID=
SAMURAI_ALERTS=telegram
# WorldMonitor CII feed (ADR-0002); adapter stays parked until this is set
WORLDMONITOR_API_KEY=
FRED_API_KEY=
